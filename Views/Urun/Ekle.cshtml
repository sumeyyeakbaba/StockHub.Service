@model StockHub.Web.Models.UrunEkleModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Ürün Tanımlama</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Hata</div>
                    }

                    <form asp-action="Ekle" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ürün Adı</label>
                                <input asp-for="UrunAdi" class="form-control" placeholder="Örn: Logitech Mouse" />
                                <span asp-validation-for="UrunAdi" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Barkod</label>
                                <input asp-for="Barkod" class="form-control" placeholder="Örn: 869001122" />
                                <span asp-validation-for="Barkod" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Kategori</label>
                                <input asp-for="Kategori" class="form-control" placeholder="Örn: Elektronik" />
                                <span asp-validation-for="Kategori" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Birim Fiyat (TL)</label>
                                <input asp-for="UrunFiyati" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="UrunFiyati" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Görsel URL</label>
                                <input asp-for="UrunResimUrl" class="form-control" value="https://placehold.co/150" />
                                <span asp-validation-for="UrunResimUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Başlangıç Stok Miktarı</label>
                                <input asp-for="StokMiktari" type="number" class="form-control" placeholder="0" />
                                <span asp-validation-for="StokMiktari" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Kritik Stok Seviyesi</label>
                                <input asp-for="KritikStokSeviyesi" type="number" class="form-control" placeholder="10" />
                                <span asp-validation-for="KritikStokSeviyesi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-save me-1"></i> Veritabanına Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div></div>