@model StockHub.Web.Models.DashboardOzetModel
@{
    ViewData["Title"] = "Depo Yönetim Paneli";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Depo Genel Durumu
            </h2>
            <p class="text-muted mb-0">MongoDB üzerinden anlık hesaplanan depo envanter ve hareket metrikleri</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Urun" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                <i class="bi bi-boxes me-1"></i> Envanter Listesi
            </a>
            <a asp-controller="Urun" asp-action="Ekle" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Hızlı Ürün Tanımla
            </a>
        </div>
    </div>

    @if ((Model?.KritikStokUrunSayisi ?? 0) > 0)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between border-0 shadow-sm rounded-3 mb-4 p-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-3 me-3 text-danger"></i>
                <div>
                    <strong class="d-block">Dikkat: Kritik Seviyede @Model.KritikStokUrunSayisi Ürün Bulunuyor!</strong>
                    <small class="text-dark opacity-75">Stoğu kritik eşiğin altına düşen ürünler için acil mal kabul (stok girişi) yapılması önerilir.</small>
                </div>
            </div>
            <a asp-controller="Urun" asp-action="Index" class="btn btn-sm btn-danger px-3 py-2 fw-semibold">
                Ürünleri İncele <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }

    <!-- Metrik Kartları -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold mb-2">Toplam Ürün Çeşidi</h6>
                        <h2 class="display-6 fw-bold mb-0">@(Model?.ToplamUrunSayisi ?? 0)</h2>
                        <small class="text-white-50">Kayıtlı aktif ürün</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-box-seam"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold mb-2">Toplam Stok Miktarı</h6>
                        <h2 class="display-6 fw-bold mb-0">@(Model?.ToplamStokMiktari ?? 0) <small class="fs-6">Adet</small></h2>
                        <small class="text-white-50">Depodaki fiziki miktar</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-layers"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold mb-2">Toplam Envanter Değeri</h6>
                        <h2 class="fs-2 fw-bold mb-0">@(Model?.ToplamStokDegeri.ToString("N2") ?? "0.00") <small class="fs-6">TL</small></h2>
                        <small class="text-white-50">Toplam parasal değer</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-cash-coin"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-danger text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center p-4">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold mb-2">Kritik Stok Uyarısı</h6>
                        <h2 class="display-6 fw-bold mb-0">@(Model?.KritikStokUrunSayisi ?? 0)</h2>
                        <small class="text-white-50">Stok &le; 10 olanlar</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>